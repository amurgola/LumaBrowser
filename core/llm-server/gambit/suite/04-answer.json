[
  {
    "id": "answer-reveal-token",
    "group": "answer",
    "requires": ["web"],
    "prompt": "Open https://lumabyte.com/automation-test, click 'Reveal secret', and tell me the exact secret code it shows.",
    "expect": {
      "toolCalls": [
        { "tool": "navigate", "params": { "url": { "regex": "automation-test" } } },
        { "tool": "click", "success": true }
      ],
      "ordered": true,
      "maxIterations": 10,
      "finalAnswer": {
        "regex": "LUMA-\\d{4}",
        "notContains": "LUMA-0000"
      }
    }
  },
  {
    "id": "answer-cheapest-product",
    "group": "answer",
    "requires": ["web"],
    "prompt": "Open https://lumabyte.com/automation-test and tell me which product in the products table is cheapest, and its price.",
    "expect": {
      "toolCalls": [
        { "tool": "navigate", "params": { "url": { "regex": "automation-test" } } }
      ],
      "maxIterations": 8,
      "finalAnswer": { "contains": ["Widget C", "9.49"] }
    }
  },
